# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super_secret_election_jwt_key_replace_in_production
JWT_EXPIRES_IN=2h

# MongoDB Connection String (Fallback in-memory storage used automatically if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/voting_system

# Blockchain / EVM Configuration (Optional: set when connecting to a live EVM node/testnet)
RPC_URL=
CONTRACT_ADDRESS=
RELAYER_PRIVATE_KEY=

